    {
      "name": "Fitness Classes",
      "item": [
        {
          "name": "Create Class",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('classId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Zumba Cardio\",\n  \"trainerName\": \"Maria\",\n  \"scheduleDate\": \"2026-04-15T09:00:00Z\",\n  \"maxCapacity\": 20,\n  \"durationMinutes\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "List Upcoming Classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "List Classes Filtered by Trainer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?trainer=Maria",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"],
              "query": [
                {
                  "key": "trainer",
                  "value": "Maria"
                }
              ]
            }
          }
        },
        {
          "name": "Get Class Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          }
        },
        {
          "name": "Book Class",
          "request": {
            "method": "POST",
            "header": [],
